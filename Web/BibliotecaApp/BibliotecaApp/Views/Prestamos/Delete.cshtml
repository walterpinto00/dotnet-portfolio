@model BibliotecaApp.ViewModels.PrestamoDetalleViewModel

@{
    ViewData["Title"] = "Eliminar Préstamo";
}

<h1>Eliminar Préstamo</h1>

<h3>¿Estás seguro de que quieres eliminar este préstamo?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NombreUsuario)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NombreUsuario)</dd>
        
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaPrestamo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaPrestamo)</dd>
        
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaDevolucion)</dt>
        <dd class="col-sm-9">@(Model.FechaDevolucion.HasValue ? Model.FechaDevolucion.Value.ToString("dd/MM/yyyy") : "Pendiente")</dd>
        
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TituloLibro)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.TituloLibro)</dd>
        
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AutorLibro)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AutorLibro)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
