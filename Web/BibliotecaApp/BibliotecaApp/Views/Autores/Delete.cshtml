@model BibliotecaApp.ViewModels.AutorDetalleViewModel

@{
    ViewData["Title"] = "Eliminar Autor";
}

<h2>Eliminar Autor</h2>

<h3 class="text-danger">¿Seguro que quieres eliminar este autor?</h3>
<p class="text-muted">Si el autor tiene libros registrados, se eliminarán también (junto con sus préstamos).</p>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Nacionalidad</dt>
        <dd class="col-sm-9">@Model.Nacionalidad</dd>

        <dt class="col-sm-3">Fecha de Nacimiento</dt>
        <dd class="col-sm-9">
            @if (Model.FechaNacimiento.HasValue)
            {
                @Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
            }
            else
            {
                <span class="text-muted">No registrada</span>
            }
        </dd>

        <dt class="col-sm-3">Total de Libros</dt>
        <dd class="col-sm-9">
            <span class="badge bg-info fs-6">@Model.TotalLibros</span>
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
